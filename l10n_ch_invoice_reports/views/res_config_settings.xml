<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting
                    id="invoice_report_options"
                    string="Invoice report options"
                    help="Those options will be applied on invoice report"
                >
                    <div class="mt16">
                        <div class="content-group" id="invoice_report_options">
                            <div>
                                <field name="print_qr_invoice" />
                                <label for="print_qr_invoice" />
                                <span
                                    class="fa fa-lg fa-building-o"
                                    title="Values set here are company-specific."
                                />
                            </div>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
